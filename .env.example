# Runtime connection used by the AI agent.
# Read-only access to business data.
DATABASE_URL=postgresql://analyst_ro:analyst_ro_pwd@localhost:5434/operations_intelligence

# Admin connection used only for database setup and synthetic data generation.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/operations_intelligence

# SQL safety
SQL_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=1000

# Reports
REPORTS_DIR=./reports

# MCP
MCP_TRANSPORT=stdio
PORT=8000